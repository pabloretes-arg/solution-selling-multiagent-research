# Copy this file to .env and fill in your own keys. Never commit .env.

# Main model (any LiteLLM model id)
MODEL_ID=nvidia_nim/nvidia/nemotron-3.5-super-vl-120b-a12b

# Optional backups, comma-separated. Used automatically if the main model fails.
FALLBACK_MODEL_IDS=gemini/gemini-flash-lite-latest

# Optional: model used only to translate a finished brief. A fast, non-reasoning model is best.
# If empty, the first backup model is used.
TRANSLATION_MODEL_ID=

# API keys for the providers above
NVIDIA_NIM_API_KEY=
GEMINI_API_KEY=

# Default value for the Market field (used when a company name is ambiguous)
DEFAULT_MARKET=Argentina

# Language the app opens in: en or es
DEFAULT_LANGUAGE=en

# Optional: Langfuse tracing (free account at cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
